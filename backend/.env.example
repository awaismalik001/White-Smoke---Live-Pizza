# Backend Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection string from Supabase
DATABASE_URL="postgresql://postgres:[MyPizzaSecret2024!]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT secret key - use a long random string
JWT_SECRET="whitesmoke-super-secret-jwt-key-change-this-in-production"

# Initial admin password (12+ characters). It is only used to create the first admin account.
ADMIN_PASSWORD="replace-with-a-unique-strong-password"

# Server port
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"
